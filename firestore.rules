rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Reusable Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isDoctor() {
      return isVerifiedUser() &&
        request.auth.token.email == 'infinitysoftwaresolutions0@gmail.com';
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role in ['patient', 'doctor'] &&
        (data.role == 'patient' || isDoctor()) &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'id', 'patientUid', 'doctorId', 'ownerName', 'email', 'phone',
          'petName', 'petSpecies', 'appointmentType', 'visitType',
          'date', 'time', 'fee', 'status', 'patientTag', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'patientUid', 'doctorId', 'ownerName', 'email', 'phone',
          'petName', 'petSpecies', 'appointmentType', 'visitType',
          'date', 'time', 'fee', 'status', 'patientTag', 'notes', 'doctorNotes',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 4 && data.id.size() <= 32 && data.id.matches('^Apt[0-9]{4,8}$') &&
        data.patientUid is string && data.patientUid.size() >= 1 && data.patientUid.size() <= 128 &&
        data.doctorId == 'dr-elena' &&
        data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 32 &&
        data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 60 &&
        data.petSpecies is string && data.petSpecies.size() >= 1 && data.petSpecies.size() <= 80 &&
        data.appointmentType in ['clinic', 'video', 'audio', 'chat', 'home'] &&
        data.visitType is string && data.visitType.size() >= 2 && data.visitType.size() <= 80 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 20 &&
        data.fee is number && data.fee >= 20 && data.fee <= 250 &&
        data.status in ['upcoming', 'completed', 'cancelled'] &&
        data.patientTag in ['New Patient', 'Returning'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('doctorNotes' in data) || (data.doctorNotes is string && data.doctorNotes.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBookedSlot(data, slotId) {
      return data.keys().hasAll([
          'slotId', 'doctorId', 'date', 'time', 'appointmentId', 'bookedByUid', 'status', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'slotId', 'doctorId', 'date', 'time', 'appointmentId', 'bookedByUid', 'status', 'updatedAt'
        ]) &&
        data.slotId is string && data.slotId == slotId &&
        data.slotId.size() >= 12 && data.slotId.size() <= 40 &&
        data.slotId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}__[a-zA-Z0-9_]+$') &&
        data.doctorId == 'dr-elena' &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() >= 4 && data.time.size() <= 20 &&
        data.appointmentId is string && data.appointmentId.size() >= 4 && data.appointmentId.size() <= 32 &&
        data.appointmentId.matches('^Apt[0-9]{4,8}$') &&
        data.bookedByUid is string && data.bookedByUid.size() >= 1 && data.bookedByUid.size() <= 128 &&
        data.status in ['reserved', 'released'] &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId} (Public Role & Display Name)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isDoctor());
      allow list: if isDoctor();

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time;

      allow update: if isValidId(userId) &&
        (isOwner(userId) || isDoctor()) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (isDoctor() || incoming().role == existing().role) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);

      allow delete: if false;

      // Split Collection PII Isolation
      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isDoctor());
        allow list: if false;

        allow create: if isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt']);

        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /appointments/{appointmentId} (Single-Doctor Schedule)
    // -------------------------------------------------------------------------
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) &&
        isVerifiedUser() &&
        (existing().patientUid == request.auth.uid || isDoctor());

      allow list: if isVerifiedUser() &&
        (resource.data.patientUid == request.auth.uid || isDoctor());

      allow create: if isValidId(appointmentId) &&
        isVerifiedUser() &&
        isValidAppointment(incoming()) &&
        incoming().id == appointmentId &&
        incoming().patientUid == request.auth.uid &&
        incoming().status == 'upcoming' &&
        !('doctorNotes' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(appointmentId) &&
        isVerifiedUser() &&
        isValidAppointment(incoming()) &&
        incoming().id == existing().id &&
        incoming().patientUid == existing().patientUid &&
        incoming().doctorId == existing().doctorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Doctor manages status and clinical notes
          (
            isDoctor() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'doctorNotes', 'updatedAt'])
          ) ||
          // Action 2: Patient cancels their own upcoming appointment (locked after terminal state)
          (
            existing().patientUid == request.auth.uid &&
            existing().status == 'upcoming' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isDoctor() && isValidId(appointmentId);
    }

    // -------------------------------------------------------------------------
    // /bookedSlots/{slotId} (PII-Free Single-Doctor Slot Locks)
    // -------------------------------------------------------------------------
    match /bookedSlots/{slotId} {
      allow get: if isValidId(slotId) && isVerifiedUser();
      allow list: if isVerifiedUser() && resource.data.doctorId == 'dr-elena';

      allow create: if isValidId(slotId) &&
        isVerifiedUser() &&
        isValidBookedSlot(incoming(), slotId) &&
        incoming().bookedByUid == request.auth.uid &&
        incoming().status == 'reserved' &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId));

      allow update: if isValidId(slotId) &&
        isVerifiedUser() &&
        isValidBookedSlot(incoming(), slotId) &&
        incoming().slotId == existing().slotId &&
        incoming().doctorId == existing().doctorId &&
        incoming().date == existing().date &&
        incoming().time == existing().time &&
        incoming().updatedAt == request.time &&
        (
          // Re-booking a previously released slot
          (
            existing().status == 'released' &&
            incoming().status == 'reserved' &&
            incoming().bookedByUid == request.auth.uid &&
            existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId))
          ) ||
          // Releasing a reserved slot on cancellation
          (
            existing().status == 'reserved' &&
            incoming().status == 'released' &&
            (existing().bookedByUid == request.auth.uid || isDoctor()) &&
            incoming().bookedByUid == existing().bookedByUid &&
            incoming().appointmentId == existing().appointmentId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isDoctor() && isValidId(slotId);
    }
  }
}
