{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public role and display name for an authenticated clinic user or doctor.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["patient", "doctor"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated private PII contact information for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AppointmentRecord": {
      "title": "AppointmentRecord",
      "description": "Veterinary clinic appointment booked by a patient with Dr. Elena Vance.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^Apt[0-9]{4,8}$"
        },
        "patientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorId": {
          "type": "string",
          "enum": ["dr-elena"]
        },
        "ownerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 32
        },
        "petName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "petSpecies": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "appointmentType": {
          "type": "string",
          "enum": ["clinic", "video", "audio", "chat", "home"]
        },
        "visitType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "fee": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["upcoming", "completed", "cancelled"]
        },
        "patientTag": {
          "type": "string",
          "enum": ["New Patient", "Returning"]
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "doctorNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "patientUid",
        "doctorId",
        "ownerName",
        "email",
        "phone",
        "petName",
        "petSpecies",
        "appointmentType",
        "visitType",
        "date",
        "time",
        "fee",
        "status",
        "patientTag",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "PII-free time slot reservation lock for Dr. Elena Vance.",
      "type": "object",
      "properties": {
        "slotId": {
          "type": "string",
          "minLength": 12,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}__[a-zA-Z0-9_]+$"
        },
        "doctorId": {
          "type": "string",
          "enum": ["dr-elena"]
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "appointmentId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^Apt[0-9]{4,8}$"
        },
        "bookedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["reserved", "released"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["slotId", "doctorId", "date", "time", "appointmentId", "bookedByUid", "status", "updatedAt"]
    },
    "PatientDoubt": {
      "title": "PatientDoubt",
      "description": "Patient care question verified by Dr. Elena Vance with WhatsApp follow-up support.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^Doubt[0-9]{4,8}$"
        },
        "patientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "whatsappPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 32
        },
        "petName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "topic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "question": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "status": {
          "type": "string",
          "enum": ["pending", "verified"]
        },
        "doctorReply": {
          "type": "string",
          "minLength": 0,
          "maxLength": 800
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "patientUid",
        "patientName",
        "whatsappPhone",
        "petName",
        "topic",
        "question",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public profile and non-privileged role metadata for signed-in patients and doctor."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII contact record accessible only to the owning user or verified clinic doctor."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/AppointmentRecord" },
      "description": "Appointments booked with Dr. Elena Vance, scoped to owning patient or verified doctor."
    },
    "/bookedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "PII-free slot availability locks for Dr. Elena Vance."
    },
    "/patientDoubts/{doubtId}": {
      "schema": { "$ref": "#/entities/PatientDoubt" },
      "description": "Patient care questions and doctor-verified clinical answers for Ajith Clinic."
    }
  }
}
